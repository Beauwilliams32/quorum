#!/usr/bin/env node
import process from 'node:process'
import { spawn } from 'node:child_process'
import { fileURLToPath } from 'node:url'

const base = process.env.QUORUM_URL || `http://127.0.0.1:${process.env.PORT || 4747}`
const args = process.argv.slice(2)
const command = args.shift() || 'status'

async function request(path, options) {
  const response = await fetch(base + path, options)
  const body = await response.json()
  if (!response.ok) throw new Error(body.error || `Quorum returned HTTP ${response.status}`)
  return body
}

function print(value) { process.stdout.write(JSON.stringify(value, null, 2) + '\n') }

try {
  if (command === 'status') print(await request('/health'))
  else if (command === 'start') {
    try { print({ running: true, url: base, health: await request('/health') }) }
    catch {
      const target = fileURLToPath(new URL('../server.js', import.meta.url))
      const port = new URL(base).port || process.env.PORT || '4747'
      spawn(process.execPath, [target], { env: { ...process.env, PORT: port }, detached: true, stdio: 'ignore' }).unref()
      print({ started: true, url: `http://127.0.0.1:${port}` })
    }
  }
  else if (command === 'dashboard') print({ url: base })
  else if (command === 'agents') print(await request('/api/agents'))
  else if (command === 'agent' && args[0] === 'show' && args[1]) print((await request('/api/agents')).agents.find(agent => agent.name === args[1] || agent.sessionId === args[1]) || { error: 'unknown agent' })
  else if (command === 'mission' && args[0] === 'list') print(await request('/api/missions'))
  else if (command === 'mission' && args[0] === 'show' && args[1]) print(await request(`/api/missions/${encodeURIComponent(args[1])}`))
  else if (command === 'mission' && args[0] === 'create' && args[1] && args[2]) print(await request('/api/missions', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title: args[1], objective: args.slice(2).join(' ') }) }))
  else if (command === 'mission' && args[0] === 'stop' && args[1]) print(await request(`/api/missions/${encodeURIComponent(args[1])}/cancel`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' }))
  else if (command === 'runtime' && args[0] === 'list') print(await request('/api/runtime-runs'))
  else if (command === 'runtime' && args[0] === 'events' && args[1]) print(await request(`/api/runtime-runs/${encodeURIComponent(args[1])}/events`))
  else if (command === 'runtime' && ['pause', 'resume', 'cancel'].includes(args[0]) && args[1]) print(await request(`/api/runtime-runs/${encodeURIComponent(args[1])}/${args[0]}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' }))
  else if (command === 'memory' && args[0] === 'status') print(await request('/api/memory/status'))
  else if (command === 'workspace' && args[0] === 'list') print(await request('/api/workspaces'))
  else if (command === 'tools') print(await request('/api/tools'))
  else if (command === 'mcp' && args[0] === 'list') print(await request('/api/mcp'))
  else if (command === 'logs') print((await request('/api/state')).feed || [])
  else if (command === 'ask' && args[0] && args[1]) print(await request('/api/missions', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title: `Ask ${args[0]}`, objective: args.slice(1).join(' '), tasks: [{ title: args.slice(1).join(' ').slice(0, 180), description: args.slice(1).join(' '), agentId: args[0] }] }) }))
  else if (command === 'artifacts') print(await request(`/api/artifacts/search?q=${encodeURIComponent(args.join(' '))}`))
  else if (command === 'pipeline' && args[0] === 'repurpose') {
    let input, segments, outputDir
    for (let i = 1; i < args.length; i++) {
      if (args[i] === '--input') input = args[++i]
      else if (args[i] === '--segments') segments = args[++i]
      else if (args[i] === '--output-dir') outputDir = args[++i]
    }
    if (!input || !segments) throw new Error('Usage: quorum pipeline repurpose --input PATH --segments JSON [--output-dir DIR]')
    const payload = { input, segments }
    if (outputDir) payload.outputDir = outputDir
    print(await request('/api/pipeline/repurpose', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }))
  }
  else if (command === 'pipeline' && args[0] === 'status' && args[1]) print(await request(`/api/pipeline/repurpose/${encodeURIComponent(args[1])}`))
  else if (command === 'pipeline' && args[0] === 'verify' && args[1]) print(await request('/api/pipeline/verify', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: args[1] }) }))
  else {
    process.stderr.write('Usage: quorum start | status | dashboard | agents | agent show <id> | mission list | mission show <id> | mission create <title> <objective> | mission stop <id> | runtime list | runtime events <id> | runtime pause|resume|cancel <id> | memory status | ask <agent> <task> | logs | tools | mcp list | workspace list | artifacts [query] | pipeline repurpose --input PATH --segments JSON [--output-dir DIR] | pipeline status <jobId> | pipeline verify <file>\n')
    process.exitCode = 2
  }
} catch (error) {
  process.stderr.write(`quorum: ${error.message}\n`)
  process.exitCode = 1
}
